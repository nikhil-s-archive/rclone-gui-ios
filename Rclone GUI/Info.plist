<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
		<string>fr</string>
	</array>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
		<string>remote-notification</string>
		<string>fetch</string>
		<string>processing</string>
	</array>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Rclone GUI uses an internal localhost server to stream your files (audio/video), including encrypted files. No traffic leaves your device through this channel.</string>
	<key>NSFaceIDUsageDescription</key>
	<string>Face ID protects access to your rclone configuration and your stored credentials.</string>
	<key>NSCameraUsageDescription</key>
	<string>Required to scan QR codes during P2P Handoff. No images are captured or stored — the video feed is analyzed locally and discarded immediately.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Lets you upload your photos and videos to your rclone remotes.</string>
	<key>RcloneKeychainAccessGroup</key>
	<string>$(DEVELOPMENT_TEAM).com.rougetet.rclone-gui</string>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.rougetet.rclone-gui.transfer-resume</string>
		<string>com.rougetet.rclone-gui.refresh</string>
		<string>com.rougetet.rclone-gui.photo-sync</string>
	</array>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Rclone GUI encrypted backup</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Owner</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.rougetet.rclone-gui.rclonebackup</string>
			</array>
		</dict>
	</array>
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.rougetet.rclone-gui.rclonebackup</string>
			<key>UTTypeDescription</key>
			<string>Rclone GUI encrypted backup</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>rclonebackup</string>
				</array>
			</dict>
		</dict>
	</array>
	<key>NSSupportsLiveActivities</key>
	<true/>
	<key>NSSupportsLiveActivitiesFrequentUpdates</key>
	<true/>
</dict>
</plist>
